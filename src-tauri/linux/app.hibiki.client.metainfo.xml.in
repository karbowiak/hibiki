<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.hibiki.client</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Hibiki</name>
  <summary>Listen to your Plex music library</summary>
  <description>
    <p>Hibiki is a desktop music player for your Plex library, with a native audio engine and a responsive interface.</p>
    <p>Browse artists and albums, manage playlists, discover internet radio and podcasts, and keep your listening history in sync with Last.fm and ListenBrainz.</p>
  </description>
  <launchable type="desktop-id">Hibiki.desktop</launchable>
  <developer_name>Michael Karbowiak</developer_name>
  <url type="homepage">https://github.com/karbowiak/hibiki</url>
  <url type="bugtracker">https://github.com/karbowiak/hibiki/issues</url>
  <categories><category>AudioVideo</category><category>Audio</category><category>Player</category></categories>
  <provides><binary>hibiki</binary></provides>
  <screenshots>
    <screenshot type="default">
      <caption>Browse your music library</caption>
      <image type="source" width="1863" height="1154">https://raw.githubusercontent.com/karbowiak/hibiki/v0.5.4/screenshots/main.png</image>
    </screenshot>
    <screenshot>
      <caption>Explore an artist and their albums</caption>
      <image type="source" width="1863" height="1154">https://raw.githubusercontent.com/karbowiak/hibiki/v0.5.4/screenshots/artist.png</image>
    </screenshot>
    <screenshot>
      <caption>Play an album from your library</caption>
      <image type="source" width="1863" height="1154">https://raw.githubusercontent.com/karbowiak/hibiki/v0.5.4/screenshots/album.png</image>
    </screenshot>
  </screenshots>
  <releases><release version="@VERSION@" date="@DATE@" type="@RELEASE_TYPE@"/></releases>
  <content_rating type="oars-1.1"/>
</component>
